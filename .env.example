# Required for the daily pipeline
GITHUB_TOKEN=your_github_personal_access_token_here
GROQ_API_KEY=your_groq_api_key_here

# Optional: PAT with public_repo (classic) or fine-grained Issues: Write
# Used only to post comments on upstream issues. Without this, commenting is skipped.
COMMENT_GITHUB_TOKEN=your_comment_pat_here
